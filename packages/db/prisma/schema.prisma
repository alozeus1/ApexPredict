generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

model WaitlistSignup {
  id              String    @id @default(cuid())
  email           String    @unique @db.Citext
  region          String?
  locale          String
  premiumIntent   Boolean   @default(false)
  referralToken   String    @unique @default(cuid())
  referredByToken String?
  verifiedAt      DateTime?
  ipHash          String
  uaHash          String
  createdAt       DateTime  @default(now())

  @@index([verifiedAt])
  @@index([referredByToken])
}

model CookieConsent {
  id           String   @id @default(cuid())
  anonDeviceId String   @unique
  ipHash       String
  choices      Json
  version      Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// Waitlist email-confirmation token (NOT the Auth.js token). Renamed from
// `VerificationToken` so the Auth.js PrismaAdapter can own that reserved name.
// The migration preserves existing rows via ALTER TABLE ... RENAME.
model WaitlistVerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email])
}

model GeoBlockEvent {
  id        String   @id @default(cuid())
  country   String
  region    String?
  ipHash    String
  uaHash    String
  createdAt DateTime @default(now())

  @@index([country, createdAt])
}

model Competition {
  id         String   @id
  name       String
  country    String
  externalId Int      @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fixtures   Fixture[]
  teams      Team[]
}

model Team {
  id            String       @id @default(cuid())
  externalId    Int          @unique
  name          String
  shortName     String?
  tla           String?
  crestUrl      String?
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id])
  homeFixtures  Fixture[]    @relation("HomeTeam")
  awayFixtures  Fixture[]    @relation("AwayTeam")
  stats         TeamStat[]

  @@index([competitionId])
}

model TeamStat {
  id             String   @id @default(cuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  competitionId  String
  form           String?
  position       Int?
  played         Int?
  won            Int?
  drawn          Int?
  lost           Int?
  goalsFor       Int?
  goalsAgainst   Int?
  goalDifference Int?
  points         Int?
  capturedAt     DateTime @default(now())

  @@index([competitionId, capturedAt])
  @@index([teamId, capturedAt])
}

model Fixture {
  id          String               @id @default(cuid())
  externalId  Int                  @unique
  competitionId String
  competition Competition          @relation(fields: [competitionId], references: [id])
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team                 @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team                 @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoff     DateTime
  status      String
  matchday    Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  odds        Odds[]
  result      FixtureResult?
  predictions PredictionSnapshot[]
  evaluations PredictionEvaluation[]

  @@index([kickoff])
  @@index([status])
  @@index([competitionId, kickoff])
}

model Odds {
  id         String   @id @default(cuid())
  fixtureId  String
  fixture    Fixture  @relation(fields: [fixtureId], references: [id])
  bookCode   String
  market     String
  price      Float
  capturedAt DateTime @default(now())

  @@index([fixtureId, market])
  @@index([capturedAt])
}

model FixtureResult {
  id         String   @id @default(cuid())
  fixtureId  String   @unique
  fixture    Fixture  @relation(fields: [fixtureId], references: [id])
  homeScore  Int
  awayScore  Int
  finishedAt DateTime
  raw        Json
}

model PredictionSnapshot {
  id          String   @id @default(cuid())
  fixtureId   String
  fixture     Fixture  @relation(fields: [fixtureId], references: [id])
  market      String   @default("1")
  probability Float    @default(0.5)
  edge        Float    @default(0)
  elo         Float
  poisson     Float
  xg          Float
  ensemble    Float
  confidence  Float
  topPick     String
  valueBet    Boolean  @default(false)
  narrative   String
  generatedAt DateTime @default(now())
  evaluation  PredictionEvaluation?

  @@index([fixtureId, generatedAt])
  @@index([market, generatedAt])
}

model PredictionEvaluation {
  id                 String             @id @default(cuid())
  predictionId        String             @unique
  prediction          PredictionSnapshot @relation(fields: [predictionId], references: [id])
  fixtureId           String
  fixture             Fixture            @relation(fields: [fixtureId], references: [id])
  market              String
  resultMarket        String
  probability         Float
  confidence          Float
  price               Float
  impliedProbability  Float
  edge                Float
  stake               Float
  returned            Float
  profit              Float
  hit                 Boolean
  brierScore          Float
  logLoss             Float
  evaluatedAt         DateTime           @default(now())

  @@index([fixtureId])
  @@index([evaluatedAt])
  @@index([market, evaluatedAt])
}

model PredictionBacktestRun {
  id                 String                       @id @default(cuid())
  windowDays         Int
  sampleSize         Int
  hitRate            Float
  roi                Float
  totalStaked        Float
  totalReturned      Float
  netProfit          Float
  averageConfidence  Float
  averageEdge        Float
  brierScore         Float
  logLoss            Float
  calibrationError   Float
  createdAt          DateTime                     @default(now())
  buckets            PredictionCalibrationBucket[]

  @@index([createdAt])
}

model PredictionCalibrationBucket {
  id                 String                @id @default(cuid())
  runId              String
  run                PredictionBacktestRun @relation(fields: [runId], references: [id])
  bucket             String
  lowerBound         Float
  upperBound         Float
  sampleSize         Int
  averageProbability Float
  observedRate       Float
  calibrationError   Float

  @@index([runId])
}

model AgentHeartbeat {
  id         String   @id @default(cuid())
  agentId    String
  status     String
  message    String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([agentId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, subscriptions, audit (Auth.js v5)
//
// Field/model names for User, Account, Session and VerificationToken follow the
// Auth.js PrismaAdapter contract (it binds to these exact names: e.g.
// `emailVerified`, `Account.refresh_token`, the model `VerificationToken`).
// Domain fields the product needs (locale, region, kycStatus, rgFlags, …) are
// added on top. Do not rename adapter-bound fields without a custom adapter.
// ─────────────────────────────────────────────────────────────────────────────

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionTier {
  FREE
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique @db.Citext
  // Auth.js adapter field (email-verification timestamp).
  emailVerified DateTime?
  name          String?
  image         String?
  // Null for OAuth-only users. argon2id hash for credential users.
  passwordHash  String?
  locale        String        @default("en")
  region        String?
  kycStatus     KycStatus     @default(NONE)
  rgFlags       Json          @default("{}")
  preferences   Json          @default("{}")
  role          UserRole      @default(USER)
  disabledAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?

  @@index([kycStatus])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js verification token (magic-link / email). Distinct from
// WaitlistVerificationToken above.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id               String               @id @default(cuid())
  userId           String               @unique
  tier             SubscriptionTier     @default(FREE)
  status           SubscriptionStatus   @default(TRIALING)
  provider         SubscriptionProvider @default(PAYSTACK)
  providerCustomer String
  providerSub      String?
  currentPeriodEnd DateTime?
  cancelAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
  @@index([action, createdAt])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([eventType, createdAt])
}

enum PickResult {
  WIN
  LOSS
  VOID
  PENDING
}

// A user's tracked bet on a fixture/market. UI lands in S3; this is the model +
// read helpers only.
model UserPick {
  id         String     @id @default(cuid())
  userId     String
  fixtureId  String
  market     String
  stake      Float
  bookCode   String?
  price      Float?
  result     PickResult @default(PENDING)
  createdAt  DateTime   @default(now())
  settledAt  DateTime?

  @@index([userId, createdAt])
  @@index([fixtureId])
}
