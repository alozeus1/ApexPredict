# DB
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DIRECT_URL=postgres://user:pass@host/db?sslmode=require

# Email
RESEND_API_KEY=
RESEND_FROM_ADDRESS=ApexPredict AI <noreply@mail.apexpredix.ai>
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=ApexPredict AI <noreply@mail.apexpredix.ai>

# Anti-bot
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Billing. With PAYSTACK_SECRET_KEY_TEST unset, checkout uses the local stub.
BILLING_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY_TEST=
PAYSTACK_SECRET_KEY_TEST=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Compliance
COMPLIANCE_GEOFENCE_ENABLED=true
COMPLIANCE_BLOCKLIST_VERSION=1

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live sports data + scheduled refresh
CRON_SECRET=replace-with-32+-bytes-random
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1,CL
# Optional override for the deep health probe (/api/health/deep). Defaults to the v4 root.
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# PII hashing.
# Encoding always uses HASH_SECRET_PRIMARY. To rotate without downtime: move the
# current key to HASH_SECRET_SECONDARY, set a new HASH_SECRET_PRIMARY; existing
# hashes still verify via the secondary until re-encoded, then clear secondary.
HASH_SECRET_PRIMARY=replace-with-32+-bytes-random
HASH_SECRET_SECONDARY=

# Locale gate (docs/strategy/2026-06-04-apexpredict-locale-gate.md).
# English is always on. Other locales ship only when their flag is 'true'.
# Launch is English-only; flip a flag once that locale passes the gate.
LOCALE_YO_ENABLED=false
LOCALE_HA_ENABLED=false
LOCALE_IG_ENABLED=false
# Auth (Auth.js v5). AUTH_SECRET signs sessions; generate with `openssl rand -base64 32`.
AUTH_SECRET=replace-with-32+-bytes-random
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend key for Auth.js email (magic-link / verification). Falls back to RESEND_API_KEY.
AUTH_RESEND_KEY=

# Toggles
POSTHOG_ENABLED=false
